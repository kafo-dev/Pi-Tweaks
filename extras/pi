#!/usr/bin/sh

# Pi wrapper: run the agent inside a bubblewrap sandbox.
#
# Pi has no built-in sandbox and runs tools with the permissions of the user
# account. This wrapper binds the whole filesystem read-only and re-binds only
# the project directory, a scratchpad, and a few state directories read-write,
# so a session cannot write anywhere else under $HOME. Started from $HOME (or
# an ancestor), the project directory stays read-only and the agent is pointed
# at the scratchpad instead. The wrapper's own config files are mounted
# read-only, whatever else is writable. A `hide-home` line in the wrapper
# config hides the rest of the home directory: it becomes an empty read-only
# directory holding only the paths this wrapper mounts.

# Resolve the real pi binary. A user or npm prefix installs it outside
# /usr/bin, so search PATH. Skip this wrapper when it shadows `pi` on PATH,
# or the wrapper would exec itself in a loop. PI_REAL_PI overrides the search.
self=$0
case "$self" in
*/*) ;;
*) self=$(command -v "$self") ;;
esac
self=$(readlink -f "$self")

if [ -n "${PI_REAL_PI:-}" ]; then
	real_pi=$PI_REAL_PI
else
	real_pi=""
	old_ifs=$IFS
	IFS=:
	# Word splitting on PATH is the point of the unquoted expansion.
	# Disable globbing so a PATH entry containing a wildcard stays literal.
	set -f
	# shellcheck disable=SC2086
	for dir in $PATH; do
		candidate="$dir/pi"
		[ -x "$candidate" ] || continue
		if [ "$(readlink -f "$candidate")" = "$self" ]; then
			continue
		fi
		real_pi=$candidate
		break
	done
	set +f
	IFS=$old_ifs
	if [ -z "$real_pi" ] && [ -x /usr/bin/pi ]; then
		real_pi=/usr/bin/pi
	fi
fi

if [ ! -x "$real_pi" ]; then
	echo "pi-wrapper: cannot find an executable pi binary; set PI_REAL_PI." >&2
	exit 1
fi

bwrap=/usr/bin/bwrap

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
cache_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}

# XDG data directory. The prune-sessions experiment moves an old session file
# to its trash rather than deleting it, so the wrapper binds the trash
# read-write; nothing else under the data directory is exposed.
data_dir=${XDG_DATA_HOME:-"$HOME/.local/share"}
trash_dir="$data_dir/Trash"

# Global skills tree; writable so skills can be installed and updated.
agents_dir="$HOME/.agents"

# Parent of the agent directory, the default being "$HOME/.pi". Files that sit
# beside the agent directory rather than inside it are placed here.
pi_dir="${agent_dir%/*}"

# Agent scratchpad, bound read-write on every run and the fallback when the
# project directory is $HOME. It sits beside the agent directory (default
# "$HOME/.pi/scratchpad"), so it follows PI_CODING_AGENT_DIR like rw-paths.txt.
scratch_dir="$pi_dir/scratchpad"

cwd=$(pwd -P)
home_real=$(cd "$HOME" && pwd -P)

# Wrapper config: one setting per line, read from a file beside the agent
# directory (default "$HOME/.pi/wrapper-config.txt"). Blank lines and lines
# starting with '#' are ignored. A line containing the word "hide-home"
# hides the home directory. Every other line is ignored. See extras/README.md.
hide_home=0
wrapper_config="$pi_dir/wrapper-config.txt"
if [ -f "$wrapper_config" ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		line=$(printf '%s\n' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		case "$line" in
		"" | '#'*) continue ;;
		esac
		case "$line" in
		*hide-home*) hide_home=1 ;;
		esac
	done <"$wrapper_config"
fi

# A management subcommand starts no agent session.
management=0
case "${1-}" in
install | remove | uninstall | update | list | config | auth)
	management=1
	;;
esac

# The lock names the session file when the user chose one with --session. Every
# other run is locked without a session, because the picker only knows the
# default session layout and a custom directory would misname the file.
named_session_file=
previous=
for argument in "$@"; do
	if [ "$previous" = "--session" ]; then
		named_session_file=$argument
	fi
	case "$argument" in
	--session=*)
		named_session_file=${argument#--session=}
		;;
	esac
	previous=$argument
done

# The picker needs node; without it the run continues without a lock. A node
# that is on PATH but cannot run, and a picker that exits non-zero, are
# reported on stderr: the picker runs as a child process before the sandbox,
# so an unread error would look like the session was never locked.
picker=""
if command -v node >/dev/null 2>&1; then
	if node --version >/dev/null 2>&1; then
		picker=$(dirname -- "$self")/pi-session-pick.mjs
		[ -f "$picker" ] || picker=""
	else
		echo "pi-wrapper: node is on PATH but does not run; session locks are off." >&2
	fi
fi

if [ "$management" = 0 ] && [ -n "$picker" ]; then
	if [ -n "$named_session_file" ]; then
		node "$picker" --agent-dir "$agent_dir" --cwd "$cwd" --pid "$$" --session-file "$named_session_file" >/dev/null ||
			echo "pi-wrapper: session lock failed." >&2
	else
		node "$picker" --agent-dir "$agent_dir" --cwd "$cwd" --pid "$$" >/dev/null ||
			echo "pi-wrapper: session lock failed." >&2
	fi
fi

if [ "${BWRAP:-1}" = "0" ]; then
	echo "pi-wrapper: bwrap is not isolating the agent; pi runs with full permissions." >&2
	sleep 1
	exec "$real_pi" "$@"
fi

host=$(hostname | tr -c 'A-Za-z0-9.-' '-')

# Binding $HOME (or an ancestor) read-write would expose the whole home
# directory, so such a session keeps the project directory read-only and uses
# the scratchpad instead.
home_readonly=0
if [ "$cwd" = "$home_real" ]; then
	home_readonly=1
fi
# A bare "/" is an ancestor of every home directory.
if [ "$cwd" = / ]; then
	home_readonly=1
fi
case "$home_real" in
"$cwd"/*)
	home_readonly=1
	;;
esac

for d in "$agent_dir" "$cache_dir" "$agents_dir" "$scratch_dir" "$trash_dir"; do
	mkdir -p "$d"
done

# Extra read-write paths, one per line, next to the agent directory (default
# "$HOME/.pi/rw-paths.txt"). Blank lines and lines starting with '#' are
# ignored, '~' expands to $HOME, and a missing path is skipped (--bind-try).
# A device node, or any path under /dev, is mounted with --dev-bind-try
# instead, since --bind marks the mount nodev and blocks the device.
# The file is read here, on the host, so it need not be reachable inside the
# sandbox.
rw_file="$pi_dir/rw-paths.txt"

# The agent cannot see the sandbox from inside, so it is told about it. Without
# this note a permission error reads as a broken environment, and the agent
# either gives up or tries to work around the mount. The mount list itself
# stays out of the note, because the user can change it between runs. Pi takes
# the note as inline text (--append-system-prompt), so nothing has to be
# written to disk.
sandbox_note="This session runs inside a bubblewrap sandbox. A write that fails with a permission or read-only-filesystem error is being blocked by the sandbox: do not try to work around the mount. Ask the user to lift the restriction on that path. On the host they can list it in $rw_file (one absolute path per line) and restart pi, or restart pi with BWRAP=0 to run without the sandbox."

# /tmp is a private tmpfs that dies with the sandbox, and the scratchpad is
# shared with every other agent that is running, so both need a rule.
scratch_note="Put scratch files in $scratch_dir, never in /tmp: /tmp is a private tmpfs that is wiped whenever the agent restarts, while the scratchpad survives. Other agents may be running against the same scratchpad, so create a subdirectory of it for this session and keep every file there."

notice="$sandbox_note $scratch_note"

# Pi recognizes a management subcommand only as its first argument; a global
# option inserted before it makes pi treat the subcommand as a session message.
# Those subcommands run no agent tools, so no note applies.
case "${1-}" in
install | remove | uninstall | update | list | config | auth)
	# Management subcommand: passed through with no notice.
	notice=""
	;;
*)
	if [ "$home_readonly" = 1 ]; then
		echo "pi-wrapper: $cwd is read-only." >&2
		notice="$notice The working directory ($cwd) is mounted read-only because it is \$HOME or above it. Use $scratch_dir for scratch files; it is writable."
	fi
	;;
esac

# Build the bwrap command in "$@": start from pi's own arguments, put the real
# binary in front, then prepend one bind per configured path. Prepending
# reverses the configured order; every bind is read-write, so their relative
# order does not matter.

if [ -n "$notice" ]; then
	set -- "$real_pi" --append-system-prompt "$notice" "$@"
else
	set -- "$real_pi" "$@"
fi

# hide-home: remount the home directory read-only. Prepending now puts this
# last of the mounts, after the paths bound back into it, so a write into the
# hidden part fails instead of landing in a tmpfs that dies with the session.
if [ "$hide_home" = 1 ]; then
	set -- --remount-ro "$HOME" "$@"
fi

# The wrapper's own two files are mounted read-only. Prepending here puts both
# after every configured bind, so a listed directory that holds one of them
# cannot make it writable, and the agent can still read the file the sandbox
# notice tells it to ask the user to extend. `--ro-bind` rather than
# `--ro-bind-try`: a bind that fails has to stop the run, not leave the file
# writable. A file that does not exist is skipped, which is the common case for
# the wrapper config.
if [ -f "$rw_file" ]; then
	set -- --ro-bind "$rw_file" "$rw_file" "$@"
fi
if [ -f "$wrapper_config" ]; then
	set -- --ro-bind "$wrapper_config" "$wrapper_config" "$@"
fi

if [ -f "$rw_file" ]; then
	while IFS= read -r path || [ -n "$path" ]; do
		path=$(printf '%s\n' "$path" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		case "$path" in
		"" | '#'*) continue ;;
		esac
		# The tilde in the "~/" pattern is a literal case pattern, not a
		# shell expansion, so shellcheck's SC2088 does not apply.
		# shellcheck disable=SC2088
		case "$path" in
		"~") path=$HOME ;;
		"~/"*) path="$HOME${path#?}" ;;
		esac
		case "$path" in
		/*) ;;
		*)
			echo "pi-wrapper: ignoring non-absolute path in $rw_file: $path" >&2
			continue
			;;
		esac
		# A device node needs a device bind: --bind mounts with nodev
		# set, which denies access to the nodes under it. Anything
		# under /dev counts, because the sandbox replaces /dev with a
		# fresh tmpfs that holds no device the host has not bound.
		case "$path" in
		/dev | /dev/*) bind_opt=--dev-bind-try ;;
		*)
			if [ -c "$path" ] || [ -b "$path" ]; then
				bind_opt=--dev-bind-try
			else
				bind_opt=--bind-try
			fi
			;;
		esac
		set -- "$bind_opt" "$path" "$path" "$@"
	done <"$rw_file"
fi

# The project directory is read-write only when it does not expose $HOME.
if [ "$home_readonly" = 0 ]; then
	set -- --bind "$cwd" "$cwd" "$@"
fi

set -- \
	--bind "$agent_dir" "$agent_dir" \
	--bind "$cache_dir" "$cache_dir" \
	--bind "$agents_dir" "$agents_dir" \
	--bind "$scratch_dir" "$scratch_dir" \
	--bind "$trash_dir" "$trash_dir" \
	"$@"

# hide-home: an empty home directory. Everything under $HOME disappears, and
# the mounts after this put back the paths this wrapper uses: the state
# directories bound just above, every rw-paths entry, and the working
# directory. The tmpfs has to follow `--ro-bind / /` and precede those
# mounts, or a later mount covers it or it covers them.
if [ "$hide_home" = 1 ]; then
	set -- --tmpfs "$HOME" "$@"
fi

set -- \
	--unshare-all \
	--share-net \
	--die-with-parent \
	--hostname "$host-Pi-Isolated" \
	--ro-bind / / \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	"$@"

exec "$bwrap" "$@"
