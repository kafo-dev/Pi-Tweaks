{
	"name": "pi-tweaks",
	"version": "0.1.0",
	"type": "module",
	"description": "Miscellaneous tools for the pi coding agent harness: skills, extensions, and a bwrap sandbox wrapper.",
	"license": "(ISC AND MIT)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kafo-dev/Pi-Tweaks.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi-package"
	],
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"check": "npm run format:check && npm run lint && npm run typecheck"
	},
	"pi": {
		"extensions": [
			"./extensions/pi-tweaks.ts",
			"./extensions/notify/index.ts",
			"./extensions/pi-bash-timeout.ts",
			"./extensions/exit-alias.ts",
			"./extensions/prompt-fragment.ts",
			"./extensions/snippet.ts",
			"./extensions/experiments/prune-sessions.ts",
			"./extensions/experiments/pop.ts",
			"./extensions/experiments/url.ts"
		],
		"skills": [
			"./skills/browser-tools",
			"./skills/web-tools"
		]
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"cheerio": "^1.1.2",
		"jsdom": "^27.0.1",
		"puppeteer-core": "^25.11.0",
		"turndown": "^7.2.2",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typebox": "^1.3.7",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.2"
	},
	"overrides": {
		"encoding-sniffer": "^1.0.2"
	}
}
