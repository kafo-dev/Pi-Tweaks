#!/usr/bin/sh
# Pi wrapper: run the agent inside a bubblewrap sandbox.
#
# Pi has no built-in sandbox and runs tools with the permissions of the user
# account. This wrapper binds the whole filesystem read-only and re-binds only
# the project directory, a scratchpad, and a few state directories read-write,
# so a session cannot write anywhere else under $HOME. Started from $HOME (or
# an ancestor), the project directory stays read-only and the agent is pointed
# at the scratchpad instead.

real_pi=/usr/bin/pi
bwrap=/usr/bin/bwrap

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
cache_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}

# Global skills tree; writable so skills can be installed and updated.
agents_dir="$HOME/.agents"

# Agent scratchpad inside the agent directory. Bound read-write by default;
# the fallback when the project directory is $HOME.
scratch_dir="$agent_dir/scratchpad"

if [ "${BWRAP:-1}" = "0" ]; then
    echo "pi-wrapper: bwrap is not isolating the agent; pi runs with full permissions." >&2
    sleep 1
    exec "$real_pi" "$@"
fi

cwd=$(pwd -P)
home_real=$(cd "$HOME" && pwd -P)

host=$(hostname | tr -c 'A-Za-z0-9.-' '-')

# Binding $HOME (or an ancestor) read-write would expose the whole home
# directory, so such a session keeps the project directory read-only and uses
# the scratchpad instead.
home_readonly=0
if [ "$cwd" = "$home_real" ]; then
    home_readonly=1
fi
# A bare "/" is an ancestor of every home directory.
if [ "$cwd" = / ]; then
    home_readonly=1
fi
case "$home_real" in
"$cwd"/*)
    home_readonly=1
    ;;
esac

for d in "$agent_dir" "$cache_dir" "$agents_dir" "$scratch_dir"; do
    mkdir -p "$d"
done

# Extra read-write paths, one per line, next to the agent directory (default
# "$HOME/.pi/rw-paths.txt"; follows PI_CODING_AGENT_DIR). Blank lines and lines
# starting with '#' are ignored, '~' expands to $HOME, and a missing path is
# skipped (--bind-try). The file is read here, on the host, so it need not be
# reachable inside the sandbox.
rw_file="${agent_dir%/*}/rw-paths.txt"

# Pi recognizes a management subcommand only as its first argument; a global
# option inserted before it makes pi treat the subcommand as a session message.
# Those subcommands run no agent tools, so the read-only notice does not apply.
notice=""
case "${1-}" in
install | remove | uninstall | update | list | config | auth)
    # Management subcommand: passed through with no notice.
    ;;
*)
    if [ "$home_readonly" = 1 ]; then
        echo "pi-wrapper: $cwd is read-only; scratch files go in $scratch_dir." >&2
        notice="The working directory ($cwd) is mounted read-only because it is \$HOME or above it. Use $scratch_dir for scratch files; it is writable."
    fi
    ;;
esac

# Build the bwrap command in "$@": start from pi's own arguments, put the real
# binary in front, then prepend one bind per configured path. Prepending
# reverses the configured order; every bind is read-write, so their relative
# order does not matter.
if [ -n "$notice" ]; then
    set -- "$real_pi" --append-system-prompt "$notice" "$@"
else
    set -- "$real_pi" "$@"
fi

if [ -f "$rw_file" ]; then
    while IFS= read -r path || [ -n "$path" ]; do
        path=$(printf '%s\n' "$path" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$path" in
        "" | '#'*) continue ;;
        esac
        case "$path" in
        "~") path=$HOME ;;
        "~/"*) path="$HOME${path#?}" ;;
        esac
        case "$path" in
        /*) ;;
        *)
            echo "pi-wrapper: ignoring non-absolute path in $rw_file: $path" >&2
            continue
            ;;
        esac
        set -- --bind-try "$path" "$path" "$@"
    done <"$rw_file"
fi

# The project directory is read-write only when it does not expose $HOME.
if [ "$home_readonly" = 0 ]; then
    set -- --bind "$cwd" "$cwd" "$@"
fi

set -- \
    --unshare-all \
    --share-net \
    --die-with-parent \
    --hostname "$host-Pi-Isolated" \
    --ro-bind / / \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --bind "$agent_dir" "$agent_dir" \
    --bind "$cache_dir" "$cache_dir" \
    --bind "$agents_dir" "$agents_dir" \
    --bind "$scratch_dir" "$scratch_dir" \
    "$@"

exec "$bwrap" "$@"
